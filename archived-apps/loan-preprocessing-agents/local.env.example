# Copy to .env in this directory and set mode 0600. Never commit credentials.
SERVER_PORT=8316
VITE_PORT=5316
DATABASE_URL=sqlite:////tmp/loan-local-status.sqlite
OPENLLMETRY_ENABLED=false
# Controlled transports only; no real cloud requests or loan processing.
LOAN_STATUS_FIXTURES=true
# Optional: use an existing protected local Python environment.
# LOAN_PYTHON=/absolute/path/to/backend/.venv/bin/python
